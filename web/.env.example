# Dev credentials, pre-filled on the sign-in form so a local test is one click.
# Copy to .env.local (gitignored) and set your own.
VITE_DEV_EMAIL=
VITE_DEV_PASSWORD=

# Only needed to point the browser at a backend other than the Vite proxy
# (which forwards /api to http://localhost:8099 by default).
# VITE_API_BASE=https://fisherman.salginci.com
