# ============================================================================
# FishMate AI — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# Gemini / Google AI  (REQUIRED)
# ---------------------------------------------------------------------------
# Server-side ONLY. This key never reaches the Android client; the backend
# exchanges it for short-lived, constrained ephemeral tokens.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Live API model used for the hands-free fishing assistant.
#   gemini-3.8-live                    -> default, lowest latency (recommended)
#   gemini-3.8-live-extended-thinking  -> more background reasoning, slower
GEMINI_LIVE_MODEL=gemini-3.8-live

# Non-live model for text-only server-side work (session reports, summaries).
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Prebuilt Live API voice name (listen to them in Google AI Studio).
GEMINI_VOICE_NAME=Kore

# ---------------------------------------------------------------------------
# Live API capabilities (all documented as supported on Gemini 3.8 Live)
# ---------------------------------------------------------------------------
# Lets the model stay silent when audio was not addressed to it. On a windy
# shoreline this is the difference between a companion and a nuisance.
GEMINI_PROACTIVE_AUDIO=true

# Lets the model read the angler's tone of voice and respond in kind.
GEMINI_AFFECTIVE_DIALOG=true

# Vision tokens per camera frame. LOW is deliberate: identifying a lure does
# not need HIGH, and a three-hour session on a phone battery does.
#   MEDIA_RESOLUTION_LOW | MEDIA_RESOLUTION_MEDIUM | MEDIA_RESOLUTION_HIGH
GEMINI_MEDIA_RESOLUTION=MEDIA_RESOLUTION_LOW

# Asynchronous (NON_BLOCKING) function calling. OFF by default: the official
# tool-use docs state only that Gemini 3.1 Flash Live lacks it and do not
# confirm support for gemini-3.8-live. See docs/GEMINI_LIVE_IMPLEMENTATION.md.
GEMINI_ASYNC_FUNCTION_CALLING=false

# Ephemeral tokens, affective dialog and proactivity are all documented as
# v1beta. Change only if the official docs do.
GEMINI_API_VERSION=v1beta

# ---------------------------------------------------------------------------
# Ephemeral token policy
# ---------------------------------------------------------------------------
# Minutes a minted token may be used to send messages on an open connection.
EPHEMERAL_TOKEN_EXPIRE_MINUTES=30
# Seconds a minted token may be used to START a new Live session.
EPHEMERAL_TOKEN_NEW_SESSION_EXPIRE_SECONDS=60
# How many Live sessions a single token may open.
EPHEMERAL_TOKEN_USES=1

# ---------------------------------------------------------------------------
# Database  (REQUIRED)
# ---------------------------------------------------------------------------
# Async driver for the app, sync driver is derived automatically for Alembic.
DATABASE_URL=postgresql+asyncpg://fishmate:fishmate@localhost:55432/fishmate

# Host ports published by docker-compose. Defaults avoid the common
# collisions on 5432 (local Postgres) and 8080 (other dev servers).
DB_HOST_PORT=55432
API_HOST_PORT=8099

# ---------------------------------------------------------------------------
# Auth  (REQUIRED — generate with: openssl rand -hex 32)
# ---------------------------------------------------------------------------
AUTH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---------------------------------------------------------------------------
# Weather / marine provider
# ---------------------------------------------------------------------------
# "open_meteo" needs NO API key and includes marine (wave/swell) data.
# "mock" returns deterministic data for demos and tests.
WEATHER_PROVIDER=open_meteo
WEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false
# Comma-separated. Use explicit origins in production.
CORS_ORIGINS=*
# Enables /api/v1/demo/* deterministic seeding endpoints.
DEMO_MODE_ENABLED=true

# ---------------------------------------------------------------------------
# Optional: Google Cloud (deployment only — see docs/DEPLOYMENT.md)
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=europe-west1
